featurePrefixes = (
{
code = "#/> classes
#/> otclasses
@num = [zero one two three four five six seven eight nine];
@sup = [zerosuperior onesuperior twosuperior threesuperior foursuperior fivesuperior sixsuperior sevensuperior eightsuperior ninesuperior];
@inf = [zeroinferior oneinferior twoinferior threeinferior fourinferior fiveinferior sixinferior seveninferior eightinferior nineinferior];
@old = [zerooldstyle oneoldstyle twooldstyle threeoldstyle fouroldstyle fiveoldstyle sixoldstyle sevenoldstyle eightoldstyle nineoldstyle];
@tab = [zero.tab one.tab two.tab three.tab four.tab five.tab six.tab seven.tab eight.tab nine.tab];
@oldtab = [zerooldstyle.tab oneoldstyle.tab twooldstyle.tab threeoldstyle.tab fouroldstyle.tab fiveoldstyle.tab sixoldstyle.tab sevenoldstyle.tab eightoldstyle.tab nineoldstyle.tab];
#/< otclasses
#/< classes

languagesystem DFLT dflt;
languagesystem latn dflt;
";
tag = Languagesystems;
}
);
features = (
{
code = "  sub @num by @old;";
tag = onum;
},
{
code = "    sub \slash by \fraction ;
    sub @num by @sup ;
    sub \fraction @sup' by @inf ;
    sub @inf @sup' by @inf ;";
tag = frac;
},
{
code = "sub @num by @sup;
pos @sup <0 120 0 0>;";
tag = sups;
},
{
code = "sub @num by @inf;
pos @inf <0 -120 0 0>;";
tag = sinf;
},
{
code = "  sub parenleft c parenright by copyright;
  sub parenleft C parenright by copyright;
  sub parenleft R parenright by registered;
  sub parenleft P parenright by uni2117;
  sub I 'l by I.bar;";
tag = liga;
},
{
code = "  sub @num by @tab;
  sub @old by @oldtab;";
